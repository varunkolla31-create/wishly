# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
WISHLY_DATA_DIR=.wishly-data

# ---- Auth ----
# dev  = local bypass sender, no Clerk keys needed
# clerk = real Clerk auth (requires the two Clerk keys below)
AUTH_MODE=dev
WISHLY_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- AI ----
# When empty, the idea generator uses a curated local bank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Secrets ----
# Required to be changed for production. Never commit real values.
AUTH_SECRET=dev-only-change-me
WISH_UNLOCK_SECRET=dev-only-change-me

# ---- Feature flags ----
FEATURE_BILLING=false
FEATURE_GROUP_MODE=true

# ---- Adapters (M5 adds dynamodb/s3) ----
DATA_ADAPTER=file
MEDIA_ADAPTER=file

# ---- AWS (M5 only) ----
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=
S3_BUCKET=
