# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
WISHLY_DATA_DIR=.wishly-data

# ---- Auth ----
# dev  = local bypass sender, no Clerk keys needed
# clerk = real Clerk auth (requires the two Clerk keys below)
AUTH_MODE=dev
WISHLY_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- AI ----
# When empty, the idea generator uses a curated local bank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- YouTube music ----
# Optional. Without it, "Paste a link" still works (oEmbed needs no key);
# Search is hidden. Never commit a real key - this repository is public.
YOUTUBE_API_KEY=
# Daily search.list calls to allow. YouTube's default bucket is 100/day.
YOUTUBE_DAILY_SEARCH_LIMIT=80
# Region for the Top 10 chart (ISO 3166-1 alpha-2: IN, US, GB...).
YOUTUBE_REGION_CODE=US
# Hours to cache the Top 10 chart.
YOUTUBE_TOP_CACHE_HOURS=6

# ---- Secrets ----
# Required to be changed for production. Never commit real values.
AUTH_SECRET=dev-only-change-me
WISH_UNLOCK_SECRET=dev-only-change-me

# ---- Feature flags ----
FEATURE_BILLING=false
FEATURE_GROUP_MODE=true

# ---- Storage ----
# Two independent switches, so data and media can use different backends.
DB_DRIVER=file                 # file | postgres | aws
MEDIA_DRIVER=file              # file | r2 | aws
# Coarse fallback, used only when the two switches above are unset.
# aws means DynamoDB + S3. Kept so older configs keep working.
STORAGE_DRIVER=file            # file | aws
# Deprecated aliases of DB_DRIVER / MEDIA_DRIVER. Leave blank.
DATA_ADAPTER=
MEDIA_ADAPTER=

# ---- Postgres / Neon (required when DB_DRIVER=postgres) ----
# Pooled string for the app. Must include sslmode=require.
DATABASE_URL=
# Optional direct (non-pooled) string; migrations prefer it when present.
DATABASE_URL_UNPOOLED=
# Contract tests only. They create and drop their own throwaway schema.
DATABASE_URL_TEST=

# ---- Cloudflare R2 (required when MEDIA_DRIVER=r2) ----
# Token needs Object Read & Write, scoped to the one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional; derived from R2_ACCOUNT_ID when blank.
R2_ENDPOINT=
# 1 enables the live R2 test (`pnpm test:r2`).
R2_TEST_LIVE=

# ---- AWS (required when DB_DRIVER=aws or MEDIA_DRIVER=aws) ----
AWS_REGION=
AWS_ENDPOINT_URL=              # optional; LocalStack or a VPC endpoint
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_WISHES_TABLE=Wishes
DYNAMODB_CONTRIBUTIONS_TABLE=Contributions
DYNAMODB_REPLIES_TABLE=Replies
S3_BUCKET=
# Some AWS consoles name the bucket var S3_BUCKET_MEDIA; either is accepted.
# S3_BUCKET_MEDIA=
