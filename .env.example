# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
WISHLY_DATA_DIR=.wishly-data

# ---- Auth ----
# dev  = local bypass sender, no Clerk keys needed
# clerk = real Clerk auth (requires the two Clerk keys below)
AUTH_MODE=dev
WISHLY_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- AI ----
# When empty, the idea generator uses a curated local bank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- YouTube music ----
# Optional. Without it, "Paste a link" still works (oEmbed needs no key);
# Search is hidden. Never commit a real key - this repository is public.
YOUTUBE_API_KEY=
# Daily search.list calls to allow. YouTube's default bucket is 100/day.
YOUTUBE_DAILY_SEARCH_LIMIT=80

# ---- Secrets ----
# Required to be changed for production. Never commit real values.
AUTH_SECRET=dev-only-change-me
WISH_UNLOCK_SECRET=dev-only-change-me

# ---- Feature flags ----
FEATURE_BILLING=false
FEATURE_GROUP_MODE=true

# ---- Storage ----
# One switch for both: aws means DynamoDB + S3.
STORAGE_DRIVER=file            # file | aws
# Optional fine-grained overrides. Leave blank to follow STORAGE_DRIVER.
DATA_ADAPTER=                  # file | dynamodb | postgres
MEDIA_ADAPTER=                 # file | s3

# ---- Postgres / Neon (required when DATA_ADAPTER=postgres) ----
# Use the pooled connection string from the Neon dashboard. Never commit it.
DATABASE_URL=

# ---- AWS (required when STORAGE_DRIVER=aws) ----
AWS_REGION=
AWS_ENDPOINT_URL=              # optional; LocalStack or a VPC endpoint
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_WISHES_TABLE=Wishes
DYNAMODB_CONTRIBUTIONS_TABLE=Contributions
DYNAMODB_REPLIES_TABLE=Replies
S3_BUCKET=
# Some AWS consoles name the bucket var S3_BUCKET_MEDIA; either is accepted.
# S3_BUCKET_MEDIA=
