{
  "name": "wishly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:aws": "vitest run --config vitest.aws.config.mts",
    "test:db": "node scripts/test-db.mjs",
    "localstack:up": "docker compose -f docker-compose.localstack.yml up -d",
    "localstack:down": "docker compose -f docker-compose.localstack.yml down -v",
    "localstack:init": "node scripts/localstack-init.mjs",
    "aws:check": "node scripts/aws-check.mjs",
    "aws:check:write": "node scripts/aws-check.mjs --write",
    "r2:check": "node scripts/r2-check.mjs",
    "test:r2": "node scripts/test-r2.mjs",
    "pretest:e2e": "node scripts/clean-next.mjs",
    "test:e2e": "playwright test",
    "music:generate": "node scripts/generate-music.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:push": "node scripts/db-migrate.mjs",
    "db:reset": "node scripts/db-migrate.mjs --reset --yes",
    "db:check": "node scripts/db-check.mjs",
    "postinstall": "node scripts/generate-music.mjs --if-missing"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@clerk/nextjs": "^7.9.25",
    "@google/genai": "^3.0.0",
    "@hookform/resolvers": "^7.0.3",
    "@node-rs/argon2": "^2.2.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "nanoid": "^6.0.2",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
